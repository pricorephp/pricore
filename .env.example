APP_NAME=Pricore
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

SIGN_UP_ENABLED=true

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# S3-compatible storage (optional, falls back to AWS_* values)
#S3_ACCESS_KEY_ID=
#S3_SECRET_ACCESS_KEY=
#S3_DEFAULT_REGION=
#S3_BUCKET=
#S3_URL=
#S3_ENDPOINT=
#S3_USE_PATH_STYLE_ENDPOINT=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI="${APP_URL}/auth/github/callback"

GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
GITLAB_REDIRECT_URI="${APP_URL}/auth/gitlab/callback"

# Comma-separated proxy addresses, or "*" to trust any proxy. Required when running
# behind a reverse proxy that terminates TLS, otherwise generated URLs fall back to http.
TRUSTED_PROXIES=

# Where dist archives are stored. Set to "s3" to use the S3 credentials above.
DIST_ENABLED=true
DIST_DISK=local
DIST_SIGNED_URL_EXPIRY=30

# Hosts that may be fetched even though they resolve into a private range — set this
# if your Git server or Composer registry is on an internal network.
OUTBOUND_ALLOWED_HOSTS=

# Requests per minute. "composer" is per token and needs headroom for a full install.
RATE_LIMIT_COMPOSER=600
RATE_LIMIT_COMPOSER_AUTH=30
RATE_LIMIT_WEBHOOKS=60

SENTRY_LARAVEL_DSN=

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

REVERB_ECHO_HOST=
REVERB_ECHO_PORT=443
REVERB_ECHO_SCHEME=https

VITE_APP_NAME="${APP_NAME}"
